# ============================================================
# Interview AI App — Backend Environment Variables
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file to version control.
# ============================================================

# ── MongoDB Atlas ────────────────────────────────────────────
# Get your connection string from: https://cloud.mongodb.com
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/interview-ai

# ── JWT Authentication ────────────────────────────────────────
# Use a long, random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret_string

# ── Google Gemini AI ──────────────────────────────────────────
# Get your API key from: https://aistudio.google.com/app/apikey
# The free tier supports ~60 requests/minute — sufficient for development.
GOOGLE_GENAI_API_KEY=your_gemini_api_key_here
